{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.local/schemas/baseline-observations-v1.schema.json",
  "title": "SpongeTube Baseline Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "cacheBytesAtPreparation",
    "cacheBytesAtEnd",
    "cacheDeltaBytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "cacheBytesAtPreparation": { "type": "integer", "minimum": 0 },
    "cacheBytesAtEnd": { "type": "integer", "minimum": 0 },
    "cacheDeltaBytes": { "type": "integer" }
  }
}
