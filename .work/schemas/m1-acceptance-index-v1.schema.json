{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/m1-acceptance-index-v1.schema.json",
  "title": "SpongeTube M1 Canonical Acceptance Index v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "gitCommit",
    "status",
    "gateCount",
    "manifest",
    "gates",
    "artifacts",
    "compatibility",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": ["PASS"]
    },
    "gateCount": {
      "type": "integer",
      "const": 16
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "required": ["gateId", "status", "proofs"],
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^M1-ACC-(0[1-9]|1[0-6])$"
          },
          "status": {
            "enum": ["PASS"]
          },
          "proofs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["api23", "api34"],
      "properties": {
        "api23": {
          "enum": ["PASS"]
        },
        "api34": {
          "enum": ["PASS"]
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
