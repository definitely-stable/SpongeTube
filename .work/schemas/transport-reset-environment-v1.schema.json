{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/transport-reset-environment-v1.schema.json",
  "title": "SpongeTube M2-G2-D Transport Reset Environment v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sourceHeadCommit",
    "checkoutCommit",
    "harness",
    "transportPath",
    "androidRuntime",
    "codeFingerprint",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "sourceHeadCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checkoutCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "harness": {
      "type": "object",
      "required": [
        "harnessId",
        "harnessVersion",
        "toolId",
        "toolVersion",
        "asset",
        "binarySha256"
      ],
      "properties": {
        "harnessId": { "type": "string", "const": "sponge-transport-harness" },
        "harnessVersion": { "type": "string", "const": "1" },
        "toolId": { "type": "string", "const": "toxiproxy" },
        "toolVersion": { "type": "string", "const": "2.12.0" },
        "asset": { "type": "string", "const": "toxiproxy-server-linux-amd64" },
        "binarySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "transportPath": {
      "type": "object",
      "required": [
        "mediaPath",
        "proxyLifecycle",
        "mediaAdbReverseUsed",
        "labControlPath",
        "processWideNetworkBinding"
      ],
      "properties": {
        "mediaPath": {
          "type": "string",
          "const": "SCOPED_NAMESPACE_VETH"
        },
        "proxyLifecycle": {
          "type": "string",
          "const": "FRESH_PER_TRIAL"
        },
        "mediaAdbReverseUsed": { "type": "boolean", "const": false },
        "labControlPath": {
          "type": "string",
          "const": "ADB_REVERSE_LOOPBACK_HTTP"
        },
        "processWideNetworkBinding": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "androidRuntime": {
      "type": "object",
      "required": [
        "deviceClass",
        "androidApi",
        "abi",
        "buildFingerprint",
        "buildId",
        "securityPatch",
        "kernelRelease",
        "batteryPolicy",
        "acPowered"
      ],
      "properties": {
        "deviceClass": { "type": "string", "const": "ANDROID_EMULATOR" },
        "androidApi": { "type": "integer", "const": 36 },
        "abi": { "type": "string", "const": "x86_64" },
        "buildFingerprint": { "type": "string", "minLength": 1 },
        "buildId": { "type": "string", "minLength": 1 },
        "securityPatch": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kernelRelease": { "type": "string", "minLength": 1 },
        "batteryPolicy": { "type": "string", "const": "CI_POWERED" },
        "acPowered": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "codeFingerprint": {
      "type": "object",
      "required": ["sha256", "files"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._/-]+$"
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
