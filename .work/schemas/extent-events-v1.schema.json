{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/extent-events-v1.schema.json",
  "title": "SpongeTube M1 Extent Event v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventSequence",
    "eventElapsedRealtimeNs",
    "sessionId",
    "extentId",
    "state",
    "integrityState",
    "trackId",
    "representationId",
    "dependencyExtentIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventSequence": {
      "type": "integer",
      "minimum": 0
    },
    "eventElapsedRealtimeNs": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "extentId": {
      "type": "string",
      "minLength": 1
    },
    "fetchId": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "RECEIVING",
        "SEALED",
        "VERIFIED",
        "DURABLE",
        "PUBLISHED",
        "QUARANTINED",
        "DELETED"
      ]
    },
    "integrityState": {
      "enum": [
        "UNKNOWN",
        "VALID",
        "CORRUPT"
      ]
    },
    "trackId": {
      "type": "string",
      "minLength": 1
    },
    "representationId": {
      "type": "string",
      "minLength": 1
    },
    "mediaStartUs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "mediaEndUs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "dependencyExtentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "byteStart": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "byteEndExclusive": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expectedLength": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actualLength": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "storagePath": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
