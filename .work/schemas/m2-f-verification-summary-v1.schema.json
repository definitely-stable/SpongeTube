{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/m2-f-verification-summary-v1.schema.json",
  "title": "SpongeTube M2-F Verification Summary v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sessionId",
    "caseKind",
    "scenarioHash",
    "semanticDigest",
    "status",
    "routeEventCount",
    "physicalAttemptCount",
    "gates",
    "checks",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "caseKind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "scenarioHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": { "type": "string", "const": "PASS" },
    "routeEventCount": { "type": "integer", "minimum": 1 },
    "physicalAttemptCount": { "type": "integer", "minimum": 1 },
    "gates": {
      "type": "object",
      "required": ["M2-ACC-03", "M2-ACC-04", "M2-ACC-05", "M2-ACC-06"],
      "properties": {
        "M2-ACC-03": {
          "type": "string",
          "enum": ["PASS", "NOT_APPLICABLE"]
        },
        "M2-ACC-04": { "type": "string", "const": "PASS" },
        "M2-ACC-05": { "type": "string", "const": "PASS" },
        "M2-ACC-06": { "type": "string", "const": "PASS" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
