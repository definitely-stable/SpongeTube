{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/recovery-verification-summary-v1.schema.json",
  "title": "SpongeTube M2-C Recovery Verification Summary v1",
  "description": "Concise result of scripts/measurement/m2_recovery_oracle.py over one run's failure-decision-events-v1, recovery-budget-events-v1 and fetch-events-v3 artifacts. The full artifacts stay CI artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sessionId",
    "policyId",
    "status",
    "chainCount",
    "physicalAttemptCount",
    "chargedAttemptCount",
    "failureCount",
    "originRequestCount",
    "terminalCounts",
    "classificationCounts",
    "decisionCounts",
    "actionCounts",
    "gates",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "const": "PASS"
    },
    "chainCount": {
      "type": "integer",
      "minimum": 1
    },
    "physicalAttemptCount": {
      "type": "integer",
      "minimum": 0
    },
    "chargedAttemptCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0
    },
    "originRequestCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "terminalCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "decisionCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "actionCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "M2-ACC-05",
        "M2-ACC-06"
      ],
      "additionalProperties": false,
      "properties": {
        "M2-ACC-05": {
          "$ref": "#/$defs/gate"
        },
        "M2-ACC-06": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "NOT_EXERCISED"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
