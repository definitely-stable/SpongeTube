{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/fault-verification-summary-v1.schema.json",
  "title": "SpongeTube M2-E Fault Verification Summary v1",
  "description": "Concise PASS result produced by the independent M2-E fault oracle over scenario, manifest, harness, calibration and recovery evidence. Full source artifacts remain retained CI artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sessionId",
    "scenarioHash",
    "scenarioFamily",
    "variant",
    "primaryPlane",
    "status",
    "evidenceSource",
    "faultCount",
    "owningHarnessCount",
    "recoveryChainCount",
    "physicalAttemptCount",
    "remoteAttemptChargeCount",
    "stochastic",
    "randomSeed",
    "gates",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenarioFamily": {
      "type": "string",
      "enum": [
        "N2",
        "N3",
        "N5",
        "N6"
      ]
    },
    "variant": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "primaryPlane": {
      "type": "string",
      "enum": [
        "TRANSPORT",
        "NETWORK"
      ]
    },
    "status": {
      "type": "string",
      "const": "PASS"
    },
    "evidenceSource": {
      "type": "string",
      "enum": [
        "HOST_SCRIPTED",
        "ANDROID_FAULT_LAB"
      ]
    },
    "faultCount": {
      "type": "integer",
      "minimum": 1
    },
    "owningHarnessCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "recoveryChainCount": {
      "type": "integer",
      "minimum": 0
    },
    "physicalAttemptCount": {
      "type": "integer",
      "minimum": 0
    },
    "remoteAttemptChargeCount": {
      "type": "integer",
      "minimum": 0
    },
    "stochastic": {
      "type": "boolean"
    },
    "randomSeed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gates": {
      "type": "object",
      "required": [
        "M2-ACC-01",
        "M2-ACC-02",
        "M2-ACC-05",
        "M2-ACC-06",
        "M2-ACC-09"
      ],
      "additionalProperties": false,
      "properties": {
        "M2-ACC-01": {
          "$ref": "#/$defs/gate"
        },
        "M2-ACC-02": {
          "$ref": "#/$defs/gate"
        },
        "M2-ACC-05": {
          "$ref": "#/$defs/gate"
        },
        "M2-ACC-06": {
          "$ref": "#/$defs/gate"
        },
        "M2-ACC-09": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "NOT_EXERCISED"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
