{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spongetube.invalid/schema/network-calibration-v1.schema.json",
  "title": "SpongeTube M2-E Network Calibration v1",
  "description": "Host-fault-domain proof that the resolved media impairment was actually installed on the scoped media path while ADB/control remained outside it. No Android/host cross-clock latency is represented.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sessionId",
    "scenarioHash",
    "harnessId",
    "harnessVersion",
    "clockDomain",
    "toolVersions",
    "expectedConfig",
    "observedConfig",
    "scopeProof",
    "qdiscCounters",
    "probeSummary",
    "cleanup",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "harnessId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "harnessVersion": {
      "type": "string",
      "minLength": 1
    },
    "clockDomain": {
      "type": "string",
      "const": "HOST_FAULT_MONOTONIC"
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedConfig": {
      "$ref": "#/$defs/normalizedObject"
    },
    "observedConfig": {
      "$ref": "#/$defs/normalizedObject"
    },
    "scopeProof": {
      "type": "object",
      "required": [
        "mediaPacketsBefore",
        "mediaPacketsAfter",
        "mediaBytesBefore",
        "mediaBytesAfter",
        "controlPacketsBefore",
        "controlPacketsAfter",
        "adbHealthyBefore",
        "adbHealthyDuring",
        "adbHealthyAfter"
      ],
      "additionalProperties": false,
      "properties": {
        "mediaPacketsBefore": {
          "type": "integer",
          "minimum": 0
        },
        "mediaPacketsAfter": {
          "type": "integer",
          "minimum": 0
        },
        "mediaBytesBefore": {
          "type": "integer",
          "minimum": 0
        },
        "mediaBytesAfter": {
          "type": "integer",
          "minimum": 0
        },
        "controlPacketsBefore": {
          "type": "integer",
          "minimum": 0
        },
        "controlPacketsAfter": {
          "type": "integer",
          "minimum": 0
        },
        "adbHealthyBefore": {
          "type": "boolean"
        },
        "adbHealthyDuring": {
          "type": "boolean"
        },
        "adbHealthyAfter": {
          "type": "boolean"
        }
      }
    },
    "qdiscCounters": {
      "type": "object",
      "required": [
        "packets",
        "bytes",
        "drops",
        "overlimits",
        "requeues"
      ],
      "additionalProperties": false,
      "properties": {
        "packets": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "drops": {
          "type": "integer",
          "minimum": 0
        },
        "overlimits": {
          "type": "integer",
          "minimum": 0
        },
        "requeues": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probeSummary": {
      "type": "object",
      "required": [
        "sampleCount",
        "successCount",
        "failureCount",
        "timeoutCount",
        "minDurationNs",
        "maxDurationNs"
      ],
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "successCount": {
          "type": "integer",
          "minimum": 0
        },
        "failureCount": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutCount": {
          "type": "integer",
          "minimum": 0
        },
        "minDurationNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxDurationNs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "qdiscRemoved",
        "filtersRemoved",
        "namespaceRemoved",
        "proxiesRemoved",
        "toxicsRemoved"
      ],
      "additionalProperties": false,
      "properties": {
        "qdiscRemoved": {
          "type": "boolean"
        },
        "filtersRemoved": {
          "type": "boolean"
        },
        "namespaceRemoved": {
          "type": "boolean"
        },
        "proxiesRemoved": {
          "type": "boolean"
        },
        "toxicsRemoved": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "normalizedObject": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    }
  }
}
